# Copy these names into the deployment platform's secret/variable manager.
# Never commit a real .env file.
SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_SECRET_KEY=replace-with-a-different-32-byte-random-value
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
PGSSLMODE=require

# Use the exact production origin. Do not use *.
CORS_ORIGINS=https://example.com

# Public worker signup is disabled by default.
ALLOW_PUBLIC_WORKER_REGISTRATION=false
VITE_ALLOW_PUBLIC_REGISTRATION=false

# Never enable this on an internet-facing deployment.
ALLOW_UNSIGNED_LINE_WEBHOOKS=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
